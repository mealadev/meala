# PostgreSQL Configuration
POSTGRES_DB=meala
POSTGRES_USER=meala
POSTGRES_PASSWORD=change_me_strong_password

# FastAPI Server Security & CORS
ORG_API_KEY=change_me_org_ingestion_key
CORS_ORIGINS=http://localhost:8080,https://app.meala.dev

# Storage Paths (inside container)
RAW_LOGS_DIR=/data/raw_logs
PARQUET_DIR=/data/parquet_store

# Seed initial demo flights on first startup (true/false)
SEED_DEMO_FLIGHTS=true
